{
  "name": "shaledb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test",
    "dev": "vp run @shaledb/infra#dev",
    "verify": "vp run @shaledb/tools-formal-verification#verify",
    "trace": "node tools/trace-cli/src/trace-cli.ts",
    "scenario": "node tools/scenario-cli/src/scenario-cli.ts",
    "preview": "node tools/preview-cli/src/preview-cli.ts",
    "generate:openapi": "node packages/lsm-cloudflare/src/generate-db-openapi.ts && vp fmt docs/openapi"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
