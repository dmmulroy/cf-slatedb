+import * as OtlpExporterForFlush from "effect/observability/OtlpExporter";
+import * as ContextForFlush from "effect/Context";
+/**
+ * cf-slatedb patch: flush an event's buffered OTLP telemetry before the event
+ * settles, bounded by the exporter's shutdown budget, so a runtime torn down
+ * right after the event cannot drop it (alchemy-workerd-otlp-flush-repro).
+ */
+export const flushEventTelemetry = (context) => {
+    const flusher = ContextForFlush.getOrUndefined(context, OtlpExporterForFlush.Flusher);
+    return flusher === undefined
+        ? Effect.void
+        : flusher.flush.pipe(Effect.timeoutOption("10 seconds"), Effect.asVoid);
+};
